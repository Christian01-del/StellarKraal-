{
  "name": "stellarkraal-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && npm run migrate:dev && ts-node-dev --respawn src/index.ts",
    "build": "node api.js && tsc",
    "lint": "eslint src --max-warnings 0",
    "start": "node api.js && node dist/index.js",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit --testPathIgnorePatterns=integration.test.ts",
    "test:smoke": "jest --forceExit --testPathPatterns smoke.test.ts",
    "migrate:dev": "db-migrate up --config database.json --env dev",
    "migrate:prod": "db-migrate up --config database.json --env production",
    "migrate:down": "db-migrate down --config database.json --env dev",
    "migrate:status": "db-migrate check --config database.json --env dev",
    "migrate:check": "db-migrate check --config database.json --env dev",
    "migrate:create": "db-migrate create --config database.json --sql-file",
    "migrate:reset": "db-migrate reset --config database.json --env dev",
    "docs": "typedoc",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "openapi:sync": "node scripts/sync-openapi-version.js",
    "openapi:generate": "ts-node -P tsconfig.json scripts/generate-openapi.ts",
    "generate:alert-rules": "ts-node -P tsconfig.json scripts/generate-alert-rules.ts",
    "benchmark": "node performance/benchmarks.js",
    "perf:test": "node performance/benchmarks.js"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@stellar/stellar-sdk": "^17.0.1",
    "@types/compression": "^1.8.1",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.60.1",
    "autocannon": "^8.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "db-migrate": "^0.11.14",
    "db-migrate-sqlite3": "^0.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.2.0",
    "graphql": "^16.10.0",
    "helmet": "8.3.0",
    "js-yaml": "^5.4.1",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.6",
    "opossum": "^10.0.0",
    "pg": "^8.13.3",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "uuid": "^14.0.2",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@tsoa/cli": "^7.0.0-alpha.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/node-cron": "3.0.11",
    "@types/opossum": "^8.1.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/urijs": "^1.19.26",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.60.1",
    "db-migrate": "^0.11.14",
    "db-migrate-sqlite3": "^1.0.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "./src/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@stellar|@noble|uint8array-extras)/)"
    ],
    "globals": {
      "ts-jest": {
        "diagnostics": false
      }
    },
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/*.integration.test.ts",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 70,
        "branches": 70,
        "statements": 70
      }
    }
  }
}
